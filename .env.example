# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI providers (abstraction layer — see lib/ai in Phase 4)
# Replicate: image, video, design, audio generation — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# AI Chat — priority order if several are set: Anthropic > xAI Grok > OpenAI
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# xAI (Grok): https://console.x.ai
XAI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Email (Resend) — https://resend.com/api-keys
# Sends the welcome email on signup (lib/email/send-welcome-email.ts).
# Without a verified sending domain, RESEND_FROM_EMAIL can be left unset:
# it falls back to Resend's sandbox address, which only delivers to the
# email your Resend account was signed up with.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AI Photo Retouch (all optional — defaults shown). Processing runs on the
# server itself (no external AI API, no key needed); these only bound it.
# Max uploaded file size in MB (RAW files are often 25-60 MB). Keep it at or
# below the Supabase Storage file size limit of your project/bucket.
RETOUCH_MAX_UPLOAD_MB=50
# Largest export processed at full resolution (megapixels); bigger photos are
# downscaled to fit and the user is told.
RETOUCH_MAX_EXPORT_MEGAPIXELS=40
# Hard ceiling on decoded pixels (megapixels), against decompression bombs.
RETOUCH_MAX_INPUT_MEGAPIXELS=120
# Long edge of the interactive before/after preview (px).
RETOUCH_PREVIEW_LONG_EDGE=2048
